"""E9 / A6 step 5 -- claims ledger for the preprint (arXiv:2602.22247, research_paper_v2.tex).

One row per numeric headline claim (abstract, Results, tables). Provenance columns are a reading of the
source iteration's files (see S2_hypotheses.csv); recomputed values are read from claims_recompute.json
(04_claims_recompute.py) and S2 / audit files -- nothing is typed in by hand except the preprint's own value.
"""
from __future__ import annotations
import json
from pathlib import Path
import numpy as np, pandas as pd

HERE = Path(__file__).resolve().parent
R = json.loads((HERE / "claims_recompute.json").read_text())
A = json.loads((HERE / "audit_409.json").read_text())
S2 = pd.read_csv(HERE / "S2_hypotheses.csv")

def f(x, d=3):
    return "n/a" if x is None else (f"{x:.{d}f}" if isinstance(x, float) else str(x))
def pe(x):
    return f"{x:.2e}"

def mult(src):
    """round-2 multiplicity status of the source record(s) 'iter_0056/H01;...'"""
    out = []
    for s in src.split(";"):
        if "/" not in s: continue
        it, hid = s.split("/")
        r = S2[(S2.iteration == it) & (S2.hypothesis_id == hid)]
        if r.empty: out.append(f"{s}: not a screen record"); continue
        r = r.iloc[0]
        if r.in_183:
            out.append(f"{s}: p_r2={r.primary_p_round2} BH={r.bh_pass_round2} Bonf={r.bonferroni_pass_round2}")
        else:
            out.append(f"{s}: not in 183")
    return " | ".join(out) if out else "n/a"

K = R["gene_counts_kidney_A"]; PC = R["pair_counts_209"]; CP = R["copole_kidney_A_209"]; FK = R["full_spectra_kidney_A"]
GO = R["sv1_go_kidney_A_L11"]; SS = R["subset_spectra_kidney_A"]; CT = R["celltype_kidney_A"]; BK = R["bcell_kidney_A"]
SI = R["spectra_immune_iter46"]; TW = R["twonn_immune_iter45"]; LI = R["labels_immune"]; TF = R["tf_target_immune_iter56"]
CS = R["tf_target_cross_seed_iter57"]; ED = R["edge_immune_iter62"]; RS = R["residualised_immune_iter51_52"]["by_coord"]
GC = R["gc_immune_iter42"]; SZ = R["screen_size"]; SP = R["spearman_n5_exact"]
REB = pd.read_csv(HERE.parents[1] / "revision2_experiments/headline_rebuilt.csv")
def reb_layers(prefix):
    r = REB[REB.claim.str.match(prefix + r"_L\d+$")]
    return int((r.p < 0.05).sum()), len(r), float(r.p.min())
TRL = reb_layers("SV2_TRRUST_copole"); STL = reb_layers("SV2_STRING_copole")
H2 = pd.read_csv(HERE.parents[1] / "revision2_experiments/headline_audit_round2.csv")
h2_surv = H2[H2.bonferroni_round2].headline.tolist()
h2_exact = [h for h in h2_surv if h != "string_confidence_gradient"]
h2_exact_nostouffer = [h for h in h2_exact if h != "TF_vs_target_AUROC_joint"]
t209, m195, o187 = SS["per_layer"]["true209"], SS["per_layer"]["mis195"], SS["per_layer"]["true187_observed"]
edl = pd.DataFrame(ED["per_layer"]); tfl = pd.DataFrame(TF["per_layer"])
ctl = CT["own_convention_true_mapping"]; ct64 = CT["same_in_float64"]; ctobs = CT["observed_variant_drop_zero_rows"]

KID = "kidney_A = cycle1_main (TS KIDNEY; preprint says immune)"
IMM = "immune = cycle4_immune_main (TS immune)"
SUB209 = "subset-fitted SVD of the 209 edge-dataset genes at true rows (22 all-zero rows included)"
MIS = "subset-fitted SVD of rows 0-208 (misaligned labels; 14 zero rows dropped -> '195')"
OBS = "observed non-zero rows only (2,039), mean-centred (= stats3.svd_observed)"
FULLZ = "full matrix incl. all-zero rows, mean-centred"

rows = []
def add(cid, claim, pre, where, src, matrix, svd, genes, nperm, recomputed, status, observed="", notes=""):
    rows.append(dict(claim_id=cid, claim=claim, preprint_value=pre, preprint_location=where, source_iterations=src,
                     matrix_and_true_tissue=matrix, svd_convention=svd, gene_label_set=genes, n_perm=nperm,
                     recomputed_own_convention=recomputed, reproduces=status, observed_convention_contrast=observed,
                     notes=notes, multiplicity_round2=mult(src)))

add("C01", "Size of the screen", "63 iterations; 183 hypotheses; 13 families", "Abstract; Intro; Methods; Table S6",
    "iterations/iter_0001-0063", "n/a", "n/a", "n/a", "n/a",
    f"{SZ['records_iter_1_63']} records in {SZ['iterations_with_json_1_63']} JSON files ({SZ['iteration_dirs_1_63']} iteration dirs; iter_0001 and iter_0003 have no JSON); "
    f"{len(SZ['json_families_1_63'])} JSON families", "yes (183/63); no (families: 8 in the JSON, 13 is the preprint's own regrouping)",
    notes="Across ALL iterations: 409 JSON records in 137 files (136 of the 139 iteration folders iter_0001-0139 -- iter_0001, 0003 and 0139 have none -- plus the aborted duplicate run iter_0064_incomplete_20260225_153100, 3 records), 15 JSON families; see S2/S1.")
add("C02", "Effective-rank collapse", "23.6 (L0) -> 1.6 (L11), 14.4-fold, 'computed on the full 4,803-gene vocabulary'", "Results 2.1; Discussion; Table S6",
    "iter_0046/H02", f"{IMM} -- NOT the 4,803-gene matrix", "random 2,000-row subsample of the 4,941 rows (zero rows included; ~59% of sampled rows all-zero), p_i = s_i^2/sum s^2", "2,000 random genes", "n/a",
    f"50 random subsamples: L0 {f(SI['subsample50']['L0']['er_mean'],2)} [{f(SI['subsample50']['L0']['er_min'],2)}-{f(SI['subsample50']['L0']['er_max'],2)}], "
    f"L11 {f(SI['subsample50']['L11']['er_mean'],2)}; fold {f(SI['fold_er_subsample_mean'],1)}; full 4,941 rows: {f(SI['full4941_zero_rows']['L0']['er_sq'],2)}->{f(SI['full4941_zero_rows']['L11']['er_sq'],2)} ({f(SI['fold_er_full4941'],1)}-fold); "
    f"kidney_A full 4,803 rows (what the text says): {f(FK['legacy_full_zero'][0]['er_sq'],2)}->{f(FK['legacy_full_zero'][1]['er_sq'],2)} ({f(FK['fold_er_sq_legacy'],1)}-fold)",
    "yes on immune subsample (approx.; seed unknown); no on the matrix the text names",
    observed=f"immune observed 2,039 rows: {f(SI['observed_variant']['L0']['er_sq'],1)}->{f(SI['observed_variant']['L11']['er_sq'],1)} ({f(SI['fold_er_sq_observed'],2)}-fold)",
    notes="iter_0047 H01 itself wrote: 'SVD eff_rank: L0=236.3 -> L11=48.4 (4.9x collapse, corrects prior 14x claim)'. The preprint kept 14.4x.")
add("C03", "SV1 variance fraction", "93.4% at L11 (53.7% at L0), 'full vocabulary'", "Results 2.1", "iter_0046/H02;iter_0007/H02",
    f"{IMM} (93.4/53.7 numbers); {KID} gives 93.2/57.2 (iter_0007)", "zero rows included (2,000-row subsample / full matrix)", "2,000 random genes", "n/a",
    f"immune subsample mean L0 {f(100*SI['subsample50']['L0']['sv1_mean'],1)}%, L11 {f(100*SI['subsample50']['L11']['sv1_mean'],1)}%; kidney_A full 4,803: L0 {f(100*FK['legacy_full_zero'][0]['sv1_frac'],1)}%, L11 {f(100*FK['legacy_full_zero'][1]['sv1_frac'],1)}%",
    "yes (approx.)", observed=f"immune observed: {f(100*SI['observed_variant']['L0']['sv1_frac'],1)}% -> {f(100*SI['observed_variant']['L11']['sv1_frac'],1)}%; kidney_A observed: {f(100*FK['observed_variant'][0]['sv1_frac'],1)}% -> {f(100*FK['observed_variant'][1]['sv1_frac'],1)}%",
    notes=f"Full-matrix SV1 is the observed/unobserved axis (kidney_A L11: r = {f(GO['sv1_full_matrix_corr_with_observed_indicator'],4)} with the observed indicator). iter_0047 H02: 'Prior claim of 93.4% for SV1 was dominated by zero vectors.'")
add("C04", "SV1 variance on the named-gene submatrix", "19% (L0) -> 77% (L11), '195-gene submatrix'", "Results 2.1; Fig. 5a", "iter_0009/H03;iter_0010/H03",
    KID, SUB209, "209 genes (not 195: the 14 'OOV' exclusion came later, at iter_0030)", "n/a",
    f"{f(100*t209[0]['sv1_frac'],2)}% -> {f(100*t209[11]['sv1_frac'],2)}%", "yes (on 209 rows incl. 22 zero rows)",
    observed=f"187 observed named genes: {f(100*o187[0]['sv1_frac'],1)}% -> {f(100*o187[11]['sv1_frac'],1)}%; misaligned '195': {f(100*m195[0]['sv1_frac'],1)}% -> {f(100*m195[11]['sv1_frac'],1)}%",
    notes="The rise to 77% is driven by the 22 all-zero rows inside the 209 subset.")
add("C05", "TwoNN intrinsic dimension", "32.6 -> 18.1 (44.6% decrease), 2,000 random genes, three seeds", "Results 2.1; Table S6", "iter_0045/H02;iter_0046/H01",
    IMM, "not spectral (TwoNN on 2,000 random rows of 4,941, zero rows included)", "2,000 random genes", "n/a (Gaussian / feature-shuffle reference only)",
    "iter_0042 estimator, seeds 42/0/1: L0 " + "/".join(f(TW['by_seed'][s]['L0'], 1) for s in ('42', '0', '1')) + ", L11 " + "/".join(f(TW['by_seed'][s]['L11'], 1) for s in ('42', '0', '1')),
    "no (not exactly; seed and estimator of iter_0045 unknown, value depends on the sample: L0 range 27.8-34.4 across 3 seeds)",
    notes="'Three random seeds' in the preprint = three 256-cell extractions (cycle4 main/seed43/seed44, iter_0046 H01), not three gene samples.")
add("C06", "Participation ratio", "58 -> 9.5 (6.1-fold), '195-gene submatrix'", "Results 2.1", "iter_0031/H03",
    KID, MIS, "'195 in-vocab' = rows 0-208 minus 14 zero rows: labels are NOT on their genes' rows", "n/a",
    f"{f(m195[0]['pr'],2)} -> {f(m195[11]['pr'],2)} (misaligned rows, as executed)", "yes (exactly, on the misaligned rows)",
    observed=f"true 187 observed named genes: {f(o187[0]['pr'],2)} -> {f(o187[11]['pr'],2)}", notes="Defect D3 (gene-row misalignment) applies; the number is a property of 195 arbitrary kidney rows.")
