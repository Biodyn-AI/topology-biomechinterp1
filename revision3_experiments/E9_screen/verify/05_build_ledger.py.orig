    observed=f"observed-gene SVD, 187 genes, quartiles: OR = {f(GO['observed_variant']['GO0005615_pos_pole']['OR'],2)}, p = {f(GO['observed_variant']['GO0005615_pos_pole']['p'],2)}",
    notes=f"All {GO['n_zero_row_genes_in_top52']} never-observed named genes (IL6, CXCL8, MMP9, COL1A1, DCN, INS, ...) sit in the top-52 'extracellular' pole: the enrichment is 'secreted genes are not expressed in the 256 sampled kidney cells' (D2).")
add("C09", "SV1 cytosolic pole", "GO:0005829 OR = 2.96, p = 0.010", "Results 2.2", "iter_0007/H03", KID, FULLZ, "as C08 (bottom 52)", "n/a (Fisher)",
